{
  "name": "rn-custom-alert-prompt",
  "version": "1.2.0",
  "description": "ReactNative Alert & Prompt with no dependencies",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "rn-custom-alert-prompt-source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace rn-custom-alert-prompt-example",
    "clean": "del-cli lib",
    "build": "bob build",
    "prepare": "bob build && husky",
    "prepack": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta --npm.tag=next"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.8.3",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^21.0.2",
    "test-renderer": "^1.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FerRiv3ra/rn-custom-alert-prompt.git"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "alert",
    "prompt",
    "async",
    "promise",
    "dialog",
    "modal",
    "UI component",
    "user interaction",
    "simple",
    "lightweight",
    "zero dependencies"
  ],
  "author": "FerRivera <fernando@softvize-premier.com> (https://feriv3ra.netlify.app)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FerRiv3ra/rn-custom-alert-prompt/issues"
  },
  "homepage": "https://github.com/FerRiv3ra/rn-custom-alert-prompt#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "lint-staged": {
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "moduleNameMapper": {
      "^rn-custom-alert-prompt$": "<rootDir>/src/index.ts"
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": true
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "releaseNotes": "awk '/^## \\[${version}\\]/{f=1;next} /^## \\[/{f=0} f' CHANGELOG.md"
    },
    "hooks": {
      "before:init": [
        "yarn typecheck",
        "yarn lint",
        "yarn test"
      ],
      "after:bump": [
        "yarn build"
      ]
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/__tests__/**",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "example"
  ]
}
